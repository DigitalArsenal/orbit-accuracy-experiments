+  await referenceStates(name.replace('.SP3.gz', ''), gunzipSync(gz), { product: name, source: url, satellites },
+    { product: name, url, sha256: sha256(gz), identities: SINEX_URL, identitiesSha256: sinexSha256 });
+}
+async function gpsEsa(day) {
