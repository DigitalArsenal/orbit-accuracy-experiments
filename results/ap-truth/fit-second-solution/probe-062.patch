+// SCAN PROBE (report only): 1 on, 0 off, < 0 leaves it; `out` (16 doubles) receives the last block's figures. Returns the previous.
+SDNAP_EXPORT("sdnap_fit_probe")
+int32_t sdnap_fit_probe(int32_t on, double* out) {
+  const int32_t previous = sdnap::fitoem::probe_on();
+  if (on == 0 || on == 1) sdnap::fitoem::probe_on() = on;
+  if (out != nullptr) for (int k = 0; k < 16; ++k) out[k] = sdnap::fitoem::probe_out()[k];
+  return previous;
+}
