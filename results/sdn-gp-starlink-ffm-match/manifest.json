{
  "experiment": "sdn-gp-starlink-ffm-match",
  "commands": [
    "node experiments/sdn-gp-starlink-ffm-match/population.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/truth.mjs --workers N",
    "node experiments/sdn-gp-starlink-ffm-match/baselines.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/bench.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/comspoc.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/covariance.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/fitlength.mjs --limit 100",
    "node experiments/sdn-gp-starlink-ffm-match/fetch-kernels.mjs get <path> --dest spk/missions/<mission> (11 files, 5 s apart)",
    "node experiments/sdn-gp-starlink-ffm-match/spk-windows.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/refit.mjs --cap 30 --workers 10",
    "node experiments/sdn-gp-starlink-ffm-match/newer.mjs --shard k/4 (re-run as newer files arrive)",
    "node experiments/sdn-gp-starlink-ffm-match/newer.mjs --truth refit30 --daily-only",
    "node experiments/sdn-gp-starlink-ffm-match/m123.mjs --workers 10",
    "node experiments/sdn-gp-starlink-ffm-match/m123-report.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/fetch-horizons.mjs",
    "NODE_EXTRA_CA_CERTS=<archive>/hac/.ca/emsign-root-ca-g1.pem node experiments/sdn-gp-starlink-ffm-match/fetch-mast-tess.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/fetch-gnss-rapid.mjs --from 2026-10-11 --to 2026-10-22",
    "node experiments/sdn-gp-starlink-ffm-match/gnss-rapid-convert.mjs --from 2026-10-11 --to 2026-10-22",
    "node experiments/sdn-gp-starlink-ffm-match/baselines.mjs --source gnss-rapid,mgex-geo-rapid,mgex-igso-rapid",
    "node experiments/sdn-gp-starlink-ffm-match/spk-windows.mjs --source heo-tess",
    "node experiments/sdn-gp-starlink-ffm-match/comspoc-precise.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/fetch-slr.mjs --from 2026-10-08 --to 2026-10-24 --weeks 260912,260919,260926,261003",
    "node experiments/sdn-gp-starlink-ffm-match/slr-convert.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/baselines.mjs --source slr-low-current,slr-high-current",
    "node experiments/sdn-gp-starlink-ffm-match/sdngp-run.mjs --workers 8 [--pin <build>] (baselines.mjs --arm sdngp, spk-windows.mjs --arm sdngp, starlink-sdngp.mjs, starlink-lowering.mjs, fitlength.mjs --arm sdngp, span-windows.mjs --arm sdngp)",
    "node experiments/sdn-gp-starlink-ffm-match/span-windows.mjs (SGP4 and XP of the COMSPOC-aligned fit-span windows; the SDN-GP arm runs inside sdngp-run.mjs)",
    "node experiments/sdn-gp-starlink-ffm-match/lunar-maneuvers.mjs",
    "SDNGP_SNAPSHOT=<build> node experiments/sdn-gp-starlink-ffm-match/segment-windows.mjs --shard k/8 (inside sdngp-run.mjs: the cislunar and heliocentric packs through the segment fits)",
    "SDNGP_SNAPSHOT=<build> node experiments/sdn-gp-starlink-ffm-match/lunar-windows.mjs --shard k/8 (inside sdngp-run.mjs; the default-span rows are baselines.mjs, spk-windows.mjs and span-windows.mjs with --arm sdngp --span default)",
    "node experiments/sdn-gp-starlink-ffm-match/horizons-packs.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/regime-windows.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/score-pack.mjs --pack <pack> --start <ISO> --fit-hours <h> --predicted <states.oem>",
    "node experiments/sdn-gp-starlink-ffm-match/inventory.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/tables.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/manifest.mjs",
    "node experiments/sdn-gp-starlink-ffm-match/run.mjs --check"
  ],
